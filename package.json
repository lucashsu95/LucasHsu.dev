{
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nolebase/vitepress-plugin-enhanced-mark": "^2.6.1",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.6.1",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.6.1",
    "@nolebase/vitepress-plugin-inline-link-preview": "^2.6.1",
    "@slidev/cli": "52.15.2",
    "@slidev/theme-seriph": "^0.25.0",
    "markdown-it-mathjax3": "^4.3.2",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.12.2",
    "playwright-chromium": "^1.61.0",
    "vitepress": "1.0.0-rc.42",
    "vitepress-plugin-google-analytics": "^1.0.2",
    "vitepress-plugin-life-progress": "^0.0.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitepress build docs",
    "preview": "vitepress preview docs",
    "generate-sidebar": "node generateSidebar.js",
    "slidev:dev:python-day01": "slidev docs/slides/python-day01/slides.md --remote",
    "slidev:build:python-day01": "slidev build docs/slides/python-day01/slides.md --out ../../.vitepress/dist/slides/python-day01 --base /LucasHsu.dev/slides/python-day01/",
    "slidev:export:python-day01": "slidev export docs/slides/python-day01/slides.md --format pdf --output docs/public/slides/python-day01.pdf --with-clicks",
    "slidev:dev:java-scanner": "slidev docs/slides/java-scanner/slides.md --remote",
    "slidev:build:java-scanner": "slidev build docs/slides/java-scanner/slides.md --out ../../public/slides/java-scanner --base /LucasHsu.dev/slides/java-scanner/",
    "slidev:export:java-scanner": "slidev export docs/slides/java-scanner/slides.md --format pdf --output docs/public/slides/java-scanner.pdf --with-clicks",
    "slidev:dev:java-array-list": "slidev docs/slides/java-array-list/slides.md --remote",
    "slidev:build:java-array-list": "slidev build docs/slides/java-array-list/slides.md --out ../../public/slides/java-array-list --base /LucasHsu.dev/slides/java-array-list/",
    "slidev:export:java-array-list": "slidev export docs/slides/java-array-list/slides.md --format pdf --output docs/public/slides/java-array-list.pdf --with-clicks",
    "slidev:build:all": "pnpm slidev:build:python-day01 && pnpm slidev:build:java-scanner && pnpm slidev:build:java-array-list"
  },
  "dependencies": {
    "busuanzi.pure.js": "^1.0.3",
    "viewerjs": "^1.11.6",
    "vitepress-plugin-back-to-top": "^1.0.1"
  }
}
